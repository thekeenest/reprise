  "narrative": {
    "northStar": "The Annotated Edition",
    "overview": "A prompt is set like a page of an annotated edition. The text sits on a readable measure, and everything about it (blanks, includes, files, agent commands, record) lives in the margin. Color is one accent for what you act on. Three worlds (Edition, Machined, Quiet) share the structure and change only type, palette, density and one signature move.",
    "keyCharacteristics": [
      "Ink on paper, one accent",
      "Captions carry all metadata",
      "Index as a table of contents",
      "Margin as apparatus",
      "Native controls in every world"
    ],
    "rules": [
      {
        "name": "One accent",
        "body": "Only blanks, the caret and the primary action are colored.",
        "section": "colors"
      },
      {
        "name": "Project color is a key",
